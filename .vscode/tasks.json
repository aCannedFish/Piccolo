{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Piccolo: Build Debug",
            "type": "process",
            "command": "${workspaceFolder}/build_macos.sh",
            "args": ["debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Piccolo: Build Release",
            "type": "process",
            "command": "${workspaceFolder}/build_macos.sh",
            "args": ["release"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        }
    ]
}
